// Adicione este bloco no final do arquivo prisma/schema.prisma
// Depois rode: npx prisma generate

model DidYouKnowContent {
  id        String   @id @default(uuid())
  title     String   @unique
  content   String   @db.Text
  category  String
  active    Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("did_you_know_contents")
}

model DidYouKnowDelivery {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  contentId String   @map("content_id")
  noticeId  String?  @map("notice_id")
  weekKey   String   @map("week_key")
  channel   String   @default("AVISO_EMAIL")
  sentAt    DateTime @default(now()) @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([studentId, weekKey])
  @@index([studentId])
  @@index([contentId])
  @@map("did_you_know_deliveries")
}
