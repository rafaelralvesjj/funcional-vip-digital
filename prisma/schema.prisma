generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String?   @map("password")
  phone         String?   @map("phone")
  document      String?   @map("document")
  birthDate     DateTime? @map("birth_date")
  cref          String?   @map("cref")
  specialty     String?   @map("specialty")
  education     String?   @map("education")
  experience    String?   @map("experience")
  bio           String?   @db.Text
  active        Boolean   @default(true)
  role          String    @default("GESTOR")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts             Account[]
  sessions             Session[]
  students             Student[]
  notices              Notice[]
  questions            Question[]
  studentAuths         Student[]    @relation("StudentAuth")
  noticeProfessors     Notice[]     @relation("NoticeProfessor")
  questionTeachers     Question[]   @relation("QuestionTeacher")
  professorNoticeReads NoticeRead[] @relation("ProfessorNoticeRead")
  careEventsAuthored  StudentCareEvent[] @relation("CareEventAuthor")
  careEventsProfessor StudentCareEvent[] @relation("CareEventProfessor")
  careEventsResolved  StudentCareEvent[] @relation("CareEventResolvedBy")
  contractsProfessor      StudentContract[]  @relation("ContractProfessor")
  contractsCreated        StudentContract[]  @relation("ContractCreatedBy")
  contractPaymentsCreated ContractPayment[]   @relation("PaymentCreatedBy")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Student {
  id                             String   @id @default(uuid())
  userId                         String   @map("user_id")
  name                           String
  preferredName                  String?  @map("preferred_name")
  email                          String?
  phone                          String?
  notes                          String?
  image                          String?
  active                         Boolean  @default(true)
  userAuthId                     String?  @unique @map("user_auth_id")
  onboardingCompleto             Boolean  @default(false) @map("onboarding_completo")
  contractedTrainingDaysPerMonth Int?     @map("contracted_training_days_per_month")
  preferredWorkoutDays          String[] @default([]) @map("preferred_workout_days")
  commercialStatus               String   @default("SEM_CONTRATO_ATIVO") @map("commercial_status")
  createdAt                      DateTime @default(now()) @map("created_at")
  updatedAt                      DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAuth         User?             @relation("StudentAuth", fields: [userAuthId], references: [id])
  workoutPlans     WorkoutPlan[]
  checkIns         CheckIn[]
  weeklyFeedbacks  WeeklyFeedback[]
  notices          Notice[]
  questions        Question[]
  workouts         Workout[]
  avaliacoes       Avaliacao[]
  noticeReads      NoticeRead[]
  careEvents       StudentCareEvent[]
  trainingPreferences StudentTrainingPreference[]
  contracts        StudentContract[]
  contractPayments        ContractPayment[]
  contractLifecycleEvents ContractLifecycleEvent[]
  exerciseProgress       WorkoutExerciseProgress[]
  technicalMemories      StudentTechnicalMemory[]

  @@map("students")
}

model Avaliacao {
  id             String   @id @default(uuid())
  alunoId        String   @map("aluno_id")
  tipo           String
  mesReferencia  Int      @map("mes_referencia")
  objetivo       String
  metaEspecifica String?  @map("meta_especifica")
  peso           Float?
  altura         Float?
  abdomen        Float?
  quadril        Float?
  braco          Float?
  coxa           Float?
  gluteo         Float?
  preferencia    String?
  equipamentos   String?
  frequencia     Int?
  nivelAtividade String?  @map("nivel_atividade")
  lesoes         String?
  fotoUrl        String?  @map("foto_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@map("avaliacoes")
}

model WorkoutPlan {
  id                       String   @id @default(uuid())
  studentId                String   @map("student_id")
  name                     String
  description              String?
  active                   Boolean  @default(true)
  notes                    String?
  date                     DateTime?
  objective                String?  @db.Text
  focusAreas               String?  @map("focus_areas") @db.Text
  intensity                String?
  estimatedDurationMinutes Int?     @map("estimated_duration_minutes")
  estimatedCaloriesMin     Int?     @map("estimated_calories_min")
  estimatedCaloriesMax     Int?     @map("estimated_calories_max")
  studentSummary           String?  @map("student_summary") @db.Text
  safetyNote               String?  @map("safety_note") @db.Text
  contractId               String?  @map("contract_id")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contract  StudentContract? @relation(fields: [contractId], references: [id])
  exercises Exercise[]
  workouts  Workout[]
  careEvents StudentCareEvent[]
  exerciseProgress WorkoutExerciseProgress[]

  @@map("workout_plans")
}

model Exercise {
  id                String   @id @default(uuid())
  workoutPlanId     String   @map("workout_plan_id")
  libraryExerciseId String?  @map("library_exercise_id")
  name              String
  description       String?
  series            Int?
  reps              String?
  weight            String?
  restTime          String?  @map("rest_time")
  notes             String?
  order             Int      @default(0)
  videoUrl          String?  @map("video_url")
  imageUrl          String?  @map("image_url")
  createdAt         DateTime @default(now()) @map("created_at")

  workoutPlan     WorkoutPlan      @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  libraryExercise ExerciseLibrary? @relation(fields: [libraryExerciseId], references: [id])
  progress        WorkoutExerciseProgress[]

  @@index([libraryExerciseId])
  @@map("exercises")
}

model Workout {
  id            String   @id @default(uuid())
  studentId     String   @map("student_id")
  workoutPlanId String?  @map("workout_plan_id")
  date          DateTime
  status        String   @default("PENDENTE")
  notes         String?
  contractId    String?  @map("contract_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  workoutPlan WorkoutPlan?     @relation(fields: [workoutPlanId], references: [id])
  contract    StudentContract? @relation(fields: [contractId], references: [id])
  careEvents  StudentCareEvent[]

  @@map("workouts")
}


model WorkoutExerciseProgress {
  id            String   @id @default(uuid())
  studentId     String   @map("student_id")
  workoutPlanId String   @map("workout_plan_id")
  exerciseId    String   @map("exercise_id")
  workoutDate   DateTime @map("workout_date")
  status        String   @default("PENDENTE")
  effort        String?
  skipReason    String?  @map("skip_reason")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  workoutPlan WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercise    Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([studentId, exerciseId, workoutDate])
  @@index([studentId, workoutPlanId, workoutDate])
  @@map("workout_exercise_progress")
}

model CheckIn {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  date      DateTime @default(now())
  present   Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("check_ins")
}

model WeeklyFeedback {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  content   String
  rating    Int?
  weekStart DateTime? @map("week_start")
  createdAt DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("weekly_feedbacks")
}


model StudentCareEvent {
  id                   String    @id @default(uuid())
  studentId            String    @map("student_id")
  professorId          String?   @map("professor_id")
  authorId             String?   @map("author_id")
  eventType            String    @map("event_type")
  severity             String    @default("ATENCAO")
  status               String    @default("ABERTO")
  source               String    @default("APP_ALUNO")
  title                String
  description          String?   @db.Text
  studentMessage       String?   @map("student_message") @db.Text
  professorMessage     String?   @map("professor_message") @db.Text
  relatedWorkoutPlanId String?   @map("related_workout_plan_id")
  relatedWorkoutId     String?   @map("related_workout_id")
  contractId           String?   @map("contract_id")
  weekStart            DateTime? @map("week_start")
  weekEnd              DateTime? @map("week_end")
  studentNoticeId      String?   @map("student_notice_id")
  professorNoticeId    String?   @map("professor_notice_id")
  studentEmailSentAt   DateTime? @map("student_email_sent_at")
  professorEmailSentAt DateTime? @map("professor_email_sent_at")
  resolvedAt           DateTime? @map("resolved_at")
  resolvedById         String?   @map("resolved_by_id")
  resolutionNotes      String?   @map("resolution_notes") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  student            Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  professor          User?        @relation("CareEventProfessor", fields: [professorId], references: [id])
  author             User?        @relation("CareEventAuthor", fields: [authorId], references: [id])
  resolvedBy         User?        @relation("CareEventResolvedBy", fields: [resolvedById], references: [id])
  relatedWorkoutPlan WorkoutPlan?     @relation(fields: [relatedWorkoutPlanId], references: [id])
  relatedWorkout     Workout?         @relation(fields: [relatedWorkoutId], references: [id])
  contract           StudentContract? @relation(fields: [contractId], references: [id])

  @@index([studentId])
  @@index([professorId])
  @@index([contractId])
  @@index([status])
  @@index([eventType])
  @@index([createdAt])
  @@map("student_care_events")
}


model ServicePlan {
  id               String   @id @default(uuid())
  name             String
  description      String?  @db.Text
  workoutsPerWeek  Int      @default(2) @map("workouts_per_week")
  workoutsPerMonth Int      @default(8) @map("workouts_per_month")
  durationMonths   Int?     @map("duration_months")
  priceCents       Int      @default(0) @map("price_cents")
  active           Boolean  @default(true)
  trialDays        Int      @default(0) @map("trial_days")
  allowTrial       Boolean  @default(false) @map("allow_trial")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  contracts StudentContract[]

  @@index([active])
  @@map("service_plans")
}

model StudentContract {
  id                      String    @id @default(uuid())
  studentId               String    @map("student_id")
  planId                  String?   @map("plan_id")
  professorId             String?   @map("professor_id")
  contractNumber          String?   @map("contract_number")
  type                    String    @default("PAID")
  status                  String    @default("DRAFT")
  commercialStatus        String    @default("AGUARDANDO_ACEITE") @map("commercial_status")
  startDate               DateTime  @map("start_date")
  endDate                 DateTime  @map("end_date")
  durationMonths          Int       @default(1) @map("duration_months")
  workoutsPerWeek         Int       @default(2) @map("workouts_per_week")
  workoutsPerMonth        Int       @default(8) @map("workouts_per_month")
  totalContractedWorkouts Int       @default(8) @map("total_contracted_workouts")
  priceCents              Int       @default(0) @map("price_cents")
  paymentMode             String?   @default("UNICO") @map("payment_mode")
  source                  String?   @default("MANUAL")
  notes                   String?   @db.Text
  acceptedAt              DateTime? @map("accepted_at")
  activatedAt             DateTime? @map("activated_at")
  finalizedAt             DateTime? @map("finalized_at")
  cancelledAt             DateTime? @map("cancelled_at")
  suspendedAt             DateTime? @map("suspended_at")
  renewedFromContractId   String?   @map("renewed_from_contract_id")
  createdById             String?   @map("created_by_id")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan                ServicePlan?      @relation(fields: [planId], references: [id])
  professor           User?             @relation("ContractProfessor", fields: [professorId], references: [id])
  createdBy           User?             @relation("ContractCreatedBy", fields: [createdById], references: [id])
  renewedFromContract StudentContract?  @relation("ContractRenewal", fields: [renewedFromContractId], references: [id])
  renewedContracts    StudentContract[] @relation("ContractRenewal")
  workoutPlans        WorkoutPlan[]
  workouts            Workout[]
  careEvents          StudentCareEvent[]
  evolutionFeedbacks  EvolutionFeedback[]
  payments            ContractPayment[]
  lifecycleEvents     ContractLifecycleEvent[]

  @@index([studentId])
  @@index([status])
  @@index([commercialStatus])
  @@index([startDate, endDate])
  @@map("student_contracts")
}


model ContractPayment {
  id                String    @id @default(uuid())
  contractId        String    @map("contract_id")
  studentId         String    @map("student_id")
  amountCents       Int       @default(0) @map("amount_cents")
  dueDate           DateTime  @map("due_date")
  paidAt            DateTime? @map("paid_at")
  status            String    @default("EM_ABERTO")
  method            String?   @default("PIX")
  provider          String?
  paymentLinkUrl    String?   @map("payment_link_url") @db.Text
  externalReference String?   @map("external_reference")
  receiptUrl        String?   @map("receipt_url") @db.Text
  notes             String?   @db.Text
  createdById       String?   @map("created_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  contract  StudentContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  @@index([contractId])
  @@index([studentId])
  @@index([status])
  @@index([dueDate])
  @@map("contract_payments")
}


model ContractLifecycleEvent {
  id          String    @id @default(uuid())
  contractId  String    @map("contract_id")
  studentId   String    @map("student_id")
  eventType   String    @map("event_type")
  eventKey    String    @map("event_key")
  channel     String    @default("AVISO_EMAIL")
  noticeId    String?   @map("notice_id")
  emailSentAt DateTime? @map("email_sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  contract StudentContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  student  Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([contractId, eventType, eventKey])
  @@index([contractId])
  @@index([studentId])
  @@index([eventType])
  @@map("contract_lifecycle_events")
}

model Notice {
  id          String   @id @default(uuid())
  title       String?
  content     String
  type        String   @default("AVISO")
  authorId    String   @map("author_id")
  studentId   String?  @map("student_id")
  targetRole  String   @default("ALUNO") @map("targetRole")
  professorId String?  @map("professorId")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  author    User         @relation(fields: [authorId], references: [id])
  student   Student?     @relation(fields: [studentId], references: [id])
  reads     NoticeRead[]
  professor User?        @relation("NoticeProfessor", fields: [professorId], references: [id])

  @@map("notices")
}

model NoticeRead {
  id          String   @id @default(uuid())
  noticeId    String   @map("notice_id")
  studentId   String?  @map("student_id")
  professorId String?  @map("professor_id")
  createdAt   DateTime @default(now()) @map("created_at")

  notice    Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  professor User?    @relation("ProfessorNoticeRead", fields: [professorId], references: [id], onDelete: Cascade)

  @@unique([noticeId, studentId])
  @@unique([noticeId, professorId])
  @@map("notice_reads")
}

model Question {
  id           String    @id @default(uuid())
  studentId    String?   @map("student_id")
  parentId     String?   @map("parent_id")
  content      String
  videoUrl     String?   @map("video_url")
  imageUrl     String?   @map("image_url")
  documentUrl  String?   @map("document_url") @db.Text
  documentName String?   @map("document_name")
  documentMimeType String? @map("document_mime_type")
  answer       String?
  answeredAt   DateTime? @map("answered_at")
  answeredById String?   @map("answered_by_id")
  resolvedAt   DateTime? @map("resolved_at")
  teacherId    String?   @map("teacherId")
  senderRole   String    @default("STUDENT") @map("senderRole")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  student    Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent     Question?  @relation("QuestionThread", fields: [parentId], references: [id])
  children   Question[] @relation("QuestionThread")
  attachments QuestionAttachment[]
  answeredBy User?      @relation(fields: [answeredById], references: [id])
  teacher    User?      @relation("QuestionTeacher", fields: [teacherId], references: [id])

  @@map("questions")
}




model QuestionAttachment {
  id           String   @id @default(uuid())
  questionId   String   @map("question_id")
  kind         String
  url          String   @db.Text
  name         String?
  mimeType     String?  @map("mime_type")
  sizeBytes    Int?     @map("size_bytes")
  purpose      String?
  videoReviewSummary String?   @map("video_review_summary") @db.Text
  videoReviewedById  String?   @map("video_reviewed_by_id")
  videoReviewedAt    DateTime? @map("video_reviewed_at")
  createdAt    DateTime @default(now()) @map("created_at")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([kind])
  @@map("question_attachments")
}

model StudentTechnicalMemory {
  id                 String    @id @default(uuid())
  studentId          String    @map("student_id")
  sourceQuestionId   String?   @map("source_question_id")
  category           String    @default("DOCUMENT")
  title              String
  summary            String    @db.Text
  sourceDocumentName String?   @map("source_document_name")
  sourceDocumentUrl  String?   @map("source_document_url") @db.Text
  status             String    @default("APPROVED")
  validUntil         DateTime? @map("valid_until")
  reviewedById       String?   @map("reviewed_by_id")
  reviewedAt         DateTime? @map("reviewed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@index([sourceQuestionId])
  @@map("student_technical_memories")
}

model StudentTrainingPreference {
  id                   String    @id @default(uuid())
  studentId            String    @map("student_id")
  professorId          String?   @map("professor_id")
  sourceConversationId String    @map("source_conversation_id")
  sourceQuestionId     String    @unique @map("source_question_id")
  source               String    @default("CHAT")
  category             String
  summary              String    @db.Text
  originalMessage      String    @map("original_message") @db.Text
  status               String    @default("ACTIVE")
  currentWeekAction    String    @default("NOT_APPLICABLE") @map("current_week_action")
  relatedWorkoutId     String?   @map("related_workout_id")
  relatedWorkoutPlanId String?   @map("related_workout_plan_id")
  handledAt            DateTime? @map("handled_at")
  handledById          String?   @map("handled_by_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([professorId])
  @@index([sourceConversationId])
  @@index([status])
  @@index([currentWeekAction])
  @@map("student_training_preferences")
}

model ExerciseLibrary {
  id                String   @id @default(uuid())
  name              String
  description       String
  muscleGroup       String
  imageUrl              String?
  videoUrl              String?  @map("video_url") @db.Text
  sequenceImageUrl      String?  @map("sequence_image_url") @db.Text
  sequenceImageLabel    String?  @map("sequence_image_label")
  sequenceImageNotes    String?  @map("sequence_image_notes") @db.Text
  sequenceFramesCount   Int?     @default(0) @map("sequence_frames_count")
  sequenceGeneratedByAi Boolean  @default(false) @map("sequence_generated_by_ai")
  sequencePrompt        String?  @map("sequence_prompt") @db.Text
  active                Boolean  @default(true)
  objectiveTags         String?  @map("objective_tags") @db.Text
  locationTags      String?  @map("location_tags") @db.Text
  equipmentTags     String?  @map("equipment_tags") @db.Text
  restrictionTags   String?  @map("restriction_tags") @db.Text
  levelTags         String?  @map("level_tags") @db.Text
  intensity         String?
  instructions      String?  @db.Text
  commonMistakes    String?  @map("common_mistakes") @db.Text
  substitutions     String?  @db.Text
  safetyNotes       String?  @map("safety_notes") @db.Text
  contraindications String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  exercises Exercise[]

  @@index([active])
  @@index([muscleGroup])
  @@map("exercise_library")
}

model DidYouKnowContent {
  id        String   @id @default(uuid())
  title     String   @unique
  content   String   @db.Text
  category  String
  active    Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("did_you_know_contents")
}

model DidYouKnowDelivery {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  contentId String   @map("content_id")
  noticeId  String?  @map("notice_id")
  weekKey   String   @map("week_key")
  channel   String   @default("AVISO_EMAIL")
  sentAt    DateTime @default(now()) @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([studentId, weekKey])
  @@index([studentId])
  @@index([contentId])
  @@map("did_you_know_deliveries")
}

model WorkoutEngagementNotification {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  workoutId String?  @map("workout_id")
  noticeId  String?  @map("notice_id")
  eventType String   @map("event_type")
  eventKey  String   @map("event_key")
  channel   String   @default("AVISO")
  sentAt    DateTime @default(now()) @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([studentId, eventType, eventKey])
  @@index([studentId])
  @@index([workoutId])
  @@index([eventType])
  @@map("workout_engagement_notifications")
}

model EvolutionFeedback {
  id                     String    @id @default(uuid())
  studentId              String    @map("student_id")
  professorId            String?   @map("professor_id")
  milestone              Int
  status                 String    @default("AGUARDANDO_BIOIMPEDANCIA")
  completedWorkoutsCount Int       @default(0) @map("completed_workouts_count")
  baselineAvaliacaoId    String?   @map("baseline_avaliacao_id")
  currentAvaliacaoId     String?   @map("current_avaliacao_id")
  bioRequestNoticeId     String?   @map("bio_request_notice_id")
  professorNoticeId      String?   @map("professor_notice_id")
  studentFeedbackNoticeId String?  @map("student_feedback_notice_id")
  draft                  String?   @db.Text
  finalContent           String?   @map("final_content") @db.Text
  contractId             String?   @map("contract_id")
  bioRequestedAt         DateTime? @map("bio_requested_at")
  readyAt                DateTime? @map("ready_at")
  sentAt                 DateTime? @map("sent_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  contract               StudentContract? @relation(fields: [contractId], references: [id])

  @@unique([studentId, contractId, milestone])
  @@index([studentId])
  @@index([professorId])
  @@index([contractId])
  @@index([status])
  @@map("evolution_feedbacks")
}
