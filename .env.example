# Banco de dados PostgreSQL (formato compatível com Vercel Postgres)
DATABASE_URL="postgres://usuario:senha@localhost:5432/funcional_vip_digital"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cole_aqui_um_hash_aleatorio_de_32_caracteres"

# Provedor de login (exemplo com GitHub)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""


# Vercel Blob (uploads de fotos e vídeos no chat)
# Na Vercel, conecte o Blob Store ao projeto. O BLOB_STORE_ID e a autenticação OIDC são fornecidos automaticamente.
BLOB_STORE_ID=""
# Somente para desenvolvimento local fora da Vercel, quando necessário:
BLOB_READ_WRITE_TOKEN=""

# Asaas (checkout de planos pagos) — ver lib/asaas-client.ts e lib/asaas-webhook.ts
# "production" usa a API de produção da Asaas; qualquer outro valor (ou ausente) usa o sandbox.
ASAAS_ENV="sandbox"
# Chave de API da Asaas (painel Asaas > Integrações > API). Nunca comitar o valor real.
ASAAS_API_KEY=""
# Só defina para sobrescrever a URL base calculada a partir de ASAAS_ENV (ex.: testes locais com mock).
ASAAS_API_BASE_URL=""
# Token escolhido por nós (não gerado pela Asaas) e cadastrado no painel da Asaas ao
# registrar a URL do webhook — a Asaas reenvia esse mesmo valor no header
# "asaas-access-token" em cada chamada, o que permite validar a origem do webhook.
ASAAS_WEBHOOK_TOKEN=""
