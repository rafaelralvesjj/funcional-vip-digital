{
  "name": "meu-dia-ia",
  "version": "0.11.6",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "vercel-build": "npm run predeploy-db && prisma db push --skip-generate && prisma generate && next build",
