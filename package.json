  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@vercel/blob": "0.27.1",
    "date-fns": "3.6.0",
    "jose": "5.9.6",
    "jszip": "3.10.1",
    "lucide-react": "0.468.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.24.1",
    "nodemailer": "6.10.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "prisma": "5.22.0",
    "typescript": "5.7.2",
    "@types/nodemailer": "6.4.17"
  }
}
